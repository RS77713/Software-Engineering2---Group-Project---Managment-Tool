# Non-secret example; commands do not automatically load this file.
# Load explicitly with Node's --env-file option, or set shell environment values.
# PORT is used by ordinary startup and start:isolated; smoke:h2 chooses a free port.
PORT=3001

# Optional path for ordinary startup only. Defaults to server/data.sqlite.
# start:isolated and smoke:h2 always select their own temporary synthetic data.
DB_PATH=
