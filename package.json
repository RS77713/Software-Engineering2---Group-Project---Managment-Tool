{
  "name": "qa-management-tool",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=24 <25",
    "npm": "11.19.1"
  },
  "allowScripts": {
    "better-sqlite3": false,
    "fsevents": false
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "lint": "npm run lint -w client",
    "verify:sqlite": "node scripts/verify-sqlite.mjs",
    "test": "npm run test -w client && npm run test -w server",
    "start": "npm run start -w server",
    "start:isolated": "node scripts/start-isolated.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
